# Local environments and editor state
.conda/
.venv/
env/
venv/
ENV/
.vscode/
.idea/

# Python caches and build outputs
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
*.egg
MANIFEST

# Test, coverage, and tool caches
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.cache/
target/

# Jupyter runtime noise; notebooks under notebooks/ are intentionally tracked
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Local configuration and logs
.env
*.log
pip-log.txt
pip-delete-this-directory.txt

# Generated results are local artifacts. Keep README/manifest placeholders trackable.
results/**
!results/
!results/**/
!results/README.md
!results/**/README.md
!results/**/manifest*.tsv
!results/**/.gitkeep

# Data files are local artifacts. Keep README/manifest placeholders trackable.
data/**
!data/
!data/**/
!data/README.md
!data/**/README.md
!data/**/manifest*.tsv
!data/**/.gitkeep

# Temporary notebooks outside the organized notebook tree
*.nbconvert.ipynb
